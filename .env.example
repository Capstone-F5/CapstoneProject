# --- API Keys (Required for AI Modules) ---
# OpenAI (Whisper STT + TTS + GPT LLM)
OPENAI_API_KEY=your_openai_api_key_here

# --- OpenAI Models ---
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Backend Settings ---
HOST=0.0.0.0
PORT=8000
DEBUG=True

# --- Database Settings ---
# 방법 1 (권장): 개별 환경변수로 지정 — 호스트/포트/계정만 바꾸면 됨
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=kiosk_db

# 방법 2 (오버라이드): 전체 URL을 직접 지정할 경우 아래 주석 해제 (방법 1보다 우선함)
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/kiosk_db?charset=utf8mb4

# --- Frontend Settings (Vite) ---
# 이 값이 있어야 정적 데이터 대신 실제 API 호출로 전환됨
# frontend/.env 파일에 복사해서 사용 (루트 .env와 별개)
VITE_API_URL=http://localhost:8000

# --- AI 모듈 → 백엔드 API 연결 ---
# ai_modules/llm/api_client.py 에서 사용
API_BASE_URL=http://localhost:8000


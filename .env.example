# --- API Keys (Required for AI Modules) ---
# OpenAI (Whisper STT + TTS + GPT LLM)
OPENAI_API_KEY=your_openai_api_key_here

# --- OpenAI Models ---
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Backend Settings ---
HOST=0.0.0.0
PORT=8000
DEBUG=True

# --- Database Settings ---
# 방법 1 (권장): 개별 환경변수로 지정 — 호스트/포트/계정만 바꾸면 됨
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=kiosk_db

# 방법 2 (오버라이드): 전체 URL을 직접 지정할 경우 아래 주석 해제 (방법 1보다 우선함)
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/kiosk_db?charset=utf8mb4

# --- Frontend Settings (Vite) ---
# 루트 .env에서 직접 읽음 (vite.config.js의 envDir이 프로젝트 루트로 설정되어 있음)
#
# VITE_API_URL: 빈 값이면 Vite 프록시(/api → localhost:8000)를 통해 호출.
#   Cloudflare Tunnel 등 외부 도메인 사용 시에도 빈 값 권장.
#   백엔드를 직접 지정하려면 http://localhost:8000 등을 입력.
VITE_API_URL=
#
# VITE_HTTPS: true면 Vite 개발 서버를 HTTPS로 실행 (기본값).
#   Cloudflare Tunnel처럼 외부에서 TLS를 처리하는 경우 false로 설정.
VITE_HTTPS=true

# --- AI 모듈 → 백엔드 API 연결 ---
# ai_modules/llm/api_client.py 에서 사용
API_BASE_URL=http://localhost:8000

# --- 관리자 인증 ---
ADMIN_JWT_SECRET=change-me-to-a-random-long-string
ADMIN_JWT_EXPIRE_MINUTES=480
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-on-first-login

